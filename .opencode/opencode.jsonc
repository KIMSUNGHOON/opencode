{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gpt-oss": {
      "options": {
        "timeout": 600000,
        "baseURL": "{env:GPT_OSS_BASE_URL}"
      }
    },
    "qwen": {
      "options": {
        "timeout": 300000,
        "baseURL": "{env:QWEN_BASE_URL}"
      }
    }
  },
  "experimental": {
    "chatMaxRetries": 5
  }
}
