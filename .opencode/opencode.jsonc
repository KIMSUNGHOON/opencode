{
  "$schema": "https://opencode.ai/config.json",

  // =============================================================================
  // Single Server + Per-Request Thinking Control (Qwen3.5-122B-A10B-FP8, SGLang)
  // =============================================================================
  // ONE SGLang server (port 8000) serves both Thinking and Instruct modes.
  // Thinking mode is controlled per-request via chat_template_kwargs in extra_body.
  //
  // SGLang Launch Command (single server):
  //   python -m sglang.launch_server \
  //     --model-path Qwen/Qwen3.5-122B-A10B-FP8 --port 8000 --tp-size 8 \
  //     --mem-fraction-static 0.8 --context-length 262144 \
  //     --reasoning-parser qwen3 --tool-call-parser qwen3_coder
  //
  // Per-request thinking control via providerOptions → request body:
  //   Thinking: "chat_template_kwargs": {"enable_thinking": true}
  //   Instruct: "chat_template_kwargs": {"enable_thinking": false}
  //
  // Model Assignment:
  //   Thinking (qwen/Qwen3.5-122B-A10B-FP8):
  //     - code-reviewer, quality-checker, summary-reporter
  //     - deepwiki, analyze, wiki-page-generator
  //   Instruct (qwen-instruct/Qwen3.5-122B-A10B-FP8):
  //     - Orchestrator (code-qa), env-setup, git-input, workspace-analyzer,
  //       pre-checker, code-fixer, build-tester, function-tester,
  //       git-committer, git-pusher, file-input, module-analyzer,
  //       workspace-scanner
  // =============================================================================

  // =============================================================================
  // IMPORTANT: Environment Variable Required
  // =============================================================================
  // OpenCode hard-caps output tokens at min(model_limit, 32000) in llm.ts.
  // The "limit.output" below declares each model's capability to the framework.
  // Without the env var, actual output is capped at 32K regardless of model capability.
  // To use the full output (32K), set:
  //   export OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX=32768
  // This lifts the hard cap so models can use their declared output limit.

  // =============================================================================
  // Context Window Management
  // =============================================================================
  // auto: automatically compact (summarize) conversation when context is full
  // prune: remove old tool outputs to free context space
  // Both default to true if omitted. Explicitly enabling for clarity.
  "compaction": {
    "auto": true,
    "prune": true
  },

  "provider": {
    // -------------------------------------------------------------------------
    // Provider 1: Thinking Mode (same server, enable_thinking=true)
    // -------------------------------------------------------------------------
    // Sampling: temperature 0.6, top_p 0.95, top_k 20 (Qwen3.5 recommended)
    // chat_template_kwargs.enable_thinking=true passed per-request
    "qwen": {
      "name": "Qwen3.5-122B-A10B Thinking",
      "npm": "@ai-sdk/openai-compatible",
      "api": "http://localhost:8000/v1",
      "env": [],
      "options": {
        "apiKey": "dummy",
        "baseURL": "http://localhost:8000/v1"
      },
      "models": {
        "Qwen3.5-122B-A10B-FP8": {
          "name": "Qwen3.5-122B-A10B-FP8",
          "id": "Qwen3.5-122B-A10B-FP8",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "attachment": false,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 32768
          },
          // Qwen3.5 Thinking mode: temp 0.6, top_p 0.95, top_k 20
          // chat_template_kwargs enables thinking per-request
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    },

    // -------------------------------------------------------------------------
    // Provider 2: Instruct Mode (same server, enable_thinking=false)
    // -------------------------------------------------------------------------
    // Sampling: temperature 0.7, top_p 0.8, top_k 20 (Qwen3.5 recommended)
    // chat_template_kwargs.enable_thinking=false passed per-request
    "qwen-instruct": {
      "name": "Qwen3.5-122B-A10B Instruct",
      "npm": "@ai-sdk/openai-compatible",
      "api": "http://localhost:8000/v1",
      "env": [],
      "options": {
        "apiKey": "dummy",
        "baseURL": "http://localhost:8000/v1"
      },
      "models": {
        "Qwen3.5-122B-A10B-FP8": {
          "name": "Qwen3.5-122B-A10B-FP8",
          "id": "Qwen3.5-122B-A10B-FP8",
          "tool_call": true,
          "temperature": true,
          "reasoning": false,
          "attachment": false,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 32768
          },
          // Qwen3.5 Instruct mode: temp 0.7, top_p 0.8, top_k 20
          // chat_template_kwargs disables thinking per-request
          "options": {
            "temperature": 0.7,
            "top_p": 0.8,
            "top_k": 20,
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    }
  }
}
