{
  "$schema": "https://opencode.ai/config.json",

  // =============================================================================
  // Dual Model Provider Configuration (Both SGLang)
  // =============================================================================
  // Node 1 (port 8000): Qwen3-Next-Thinking (SGLang)  -> Reasoning-intensive agents
  // Node 2 (port 8001): Qwen3-Coder-Next (SGLang)     -> Code/utility agents
  //
  // Model Assignment:
  //   Thinking (qwen/Qwen3-Next-80B-A3B-Thinking-FP8):
  //     - code-reviewer, quality-checker, summary-reporter
  //   Coder (qwen-coder/Qwen3-Coder-Next-FP8):
  //     - Orchestrator (code-qa), env-setup, git-input, workspace-analyzer,
  //       pre-checker, code-fixer, build-tester, function-tester,
  //       git-committer, git-pusher, file-input
  // =============================================================================

  // =============================================================================
  // IMPORTANT: Environment Variable Required
  // =============================================================================
  // OpenCode hard-caps output tokens at min(model_limit, 32000) in llm.ts.
  // The "limit.output" below declares each model's capability to the framework.
  // Without the env var, actual output is capped at 32K regardless of model capability.
  // To use the full Coder output (65K) or Thinking output (32K), set:
  //   export OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX=65536
  // This lifts the hard cap so models can use their declared output limit.

  // =============================================================================
  // Context Window Management
  // =============================================================================
  // auto: automatically compact (summarize) conversation when context is full
  // prune: remove old tool outputs to free context space
  // Both default to true if omitted. Explicitly enabling for clarity.
  "compaction": {
    "auto": true,
    "prune": true
  },

  "provider": {
    // -------------------------------------------------------------------------
    // Provider 1: Thinking Model (SGLang, port 8000)
    // -------------------------------------------------------------------------
    "qwen": {
      "name": "Qwen3-Next-Thinking (Reasoning)",
      "npm": "@ai-sdk/openai-compatible",
      "api": "http://localhost:8000/v1",
      "env": [],
      "options": {
        "apiKey": "dummy",
        "baseURL": "http://localhost:8000/v1"
      },
      "models": {
        "Qwen3-Next-80B-A3B-Thinking-FP8": {
          "name": "Qwen3-Next-80B-A3B-Thinking-FP8",
          "id": "Qwen3-Next-80B-A3B-Thinking-FP8",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "attachment": false,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 32768
          },
          // Sampling params: override SDK defaults via providerOptions → request body
          // README: temperature 0.6, top_p 0.95, top_k 20
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    },

    // -------------------------------------------------------------------------
    // Provider 2: Coder Model (SGLang, port 8001)
    // -------------------------------------------------------------------------
    "qwen-coder": {
      "name": "Qwen3-Coder-Next (Code)",
      "npm": "@ai-sdk/openai-compatible",
      "api": "http://localhost:8001/v1",
      "env": [],
      "options": {
        "apiKey": "dummy",
        "baseURL": "http://localhost:8001/v1"
      },
      "models": {
        "Qwen3-Coder-Next-FP8": {
          "name": "Qwen3-Coder-Next-FP8",
          "id": "Qwen3-Coder-Next-FP8",
          "tool_call": true,
          "temperature": true,
          "reasoning": false,
          "attachment": false,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 65536
          },
          // Sampling params: override SDK defaults via providerOptions → request body
          // README: temperature 1.0, top_p 0.95, top_k 40
          "options": {
            "temperature": 1.0,
            "top_p": 0.95,
            "top_k": 40
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    }
  }
}
