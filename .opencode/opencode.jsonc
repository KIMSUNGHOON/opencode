{
  "$schema": "https://opencode.ai/config.json",

  // =============================================================================
  // Single Model Provider Configuration (GLM-4.7-FP8)
  // =============================================================================
  // GLM-4.7 is a 355B MoE model (32B active) by Z.ai, MIT license.
  // It supports tool calling, interleaved/preserved thinking, and 200K context.
  // A single model serves ALL agents — no dual-model routing needed.
  //
  // Serving (SGLang, single port 8000):
  //   python3 -m sglang.launch_server \
  //     --model-path zai-org/GLM-4.7-FP8 \
  //     --tp-size 4 \
  //     --tool-call-parser glm47 \
  //     --reasoning-parser glm45 \
  //     --mem-fraction-static 0.85 \
  //     --served-model-name GLM-4.7-FP8 \
  //     --host 0.0.0.0 --port 8000
  //
  // Serving (vLLM alternative):
  //   vllm serve zai-org/GLM-4.7-FP8 \
  //     --tensor-parallel-size 4 \
  //     --speculative-config.method mtp \
  //     --speculative-config.num_speculative_tokens 1 \
  //     --tool-call-parser glm47 \
  //     --reasoning-parser glm45 \
  //     --enable-auto-tool-choice \
  //     --served-model-name GLM-4.7-FP8
  //
  // Hardware: 8× H100 or 4× H200 (FP8)
  // =============================================================================

  // =============================================================================
  // IMPORTANT: Environment Variable Required
  // =============================================================================
  // OpenCode hard-caps output tokens at min(model_limit, 32000) in llm.ts.
  // GLM-4.7 supports up to 128K output. To use more than 32K output, set:
  //   export OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX=131072
  // This lifts the hard cap so the model can use its declared output limit.

  // =============================================================================
  // Context Window Management
  // =============================================================================
  "compaction": {
    "auto": true,
    "prune": true
  },

  "provider": {
    // -------------------------------------------------------------------------
    // Single Provider: GLM-4.7-FP8 (SGLang or vLLM, port 8000)
    // -------------------------------------------------------------------------
    // All agents use this single model. GLM-4.7 handles both reasoning-intensive
    // tasks (code review, quality check) and code/tool tasks (fixing, building)
    // via its built-in Interleaved Thinking capability.
    "glm": {
      "name": "GLM-4.7-FP8 (Z.ai)",
      "npm": "@ai-sdk/openai-compatible",
      "api": "http://localhost:8000/v1",
      "env": [],
      "options": {
        "apiKey": "dummy",
        "baseURL": "http://localhost:8000/v1"
      },
      "models": {
        "GLM-4.7-FP8": {
          "name": "GLM-4.7-FP8",
          "id": "GLM-4.7-FP8",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "attachment": false,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 131072
          },
          // Sampling params: Z.ai official recommendation
          // temperature=1.0, top_p=0.95
          // "Do NOT adjust both simultaneously" — tune one or the other.
          "options": {
            "temperature": 1.0,
            "top_p": 0.95
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    }
  }
}
