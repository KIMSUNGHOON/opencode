# =============================================================================
# OpenCode QA Sandbox - Python/CUDA 범용 템플릿
# =============================================================================
#
# 사용법:
#   docker build -t qa-sandbox -f .opencode/docker/Dockerfile.sandbox .
#   docker run --gpus all -v $(pwd):/workspace qa-sandbox <command>
#
# CA 인증서 설정:
#   빌드 전에 호스트의 CA 인증서를 .opencode/docker/certs/ 에 복사하세요:
#   cp /usr/local/share/ca-certificates/*.crt .opencode/docker/certs/
#   cp /usr/local/share/ca-certificates/*.pem .opencode/docker/certs/
#
# =============================================================================

# -----------------------------------------------------------------------------
# Base Image: NVIDIA CUDA + Python
# -----------------------------------------------------------------------------
ARG CUDA_VERSION=13.0.0
ARG PYTHON_VERSION=3.12

# Ubuntu 24.04 for Python 3.12 support
FROM nvidia/cuda:${CUDA_VERSION}-cudnn-runtime-ubuntu24.04

# -----------------------------------------------------------------------------
# Environment Variables
# -----------------------------------------------------------------------------
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Python version
ARG PYTHON_VERSION
ENV PYTHON_VERSION=${PYTHON_VERSION}

# Workspace
WORKDIR /workspace

# -----------------------------------------------------------------------------
# CA Certificates (호스트에서 복사)
# -----------------------------------------------------------------------------
# 호스트의 CA 인증서를 Docker 내부로 복사
# 빌드 전에 .opencode/docker/certs/ 디렉토리에 인증서를 복사해두세요
COPY .opencode/docker/certs/*.crt /usr/local/share/ca-certificates/ 2>/dev/null || true
COPY .opencode/docker/certs/*.pem /usr/local/share/ca-certificates/ 2>/dev/null || true

# -----------------------------------------------------------------------------
# System Dependencies
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Python
    python${PYTHON_VERSION} \
    python${PYTHON_VERSION}-dev \
    python${PYTHON_VERSION}-venv \
    python3-pip \
    # Build tools
    build-essential \
    cmake \
    git \
    curl \
    wget \
    # Utilities
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    # Update CA certificates
    && update-ca-certificates \
    # Python symlinks
    && ln -sf /usr/bin/python${PYTHON_VERSION} /usr/bin/python \
    && ln -sf /usr/bin/python${PYTHON_VERSION} /usr/bin/python3

# -----------------------------------------------------------------------------
# Python Package Manager (pip upgrade)
# -----------------------------------------------------------------------------
RUN python -m pip install --upgrade pip setuptools wheel

# -----------------------------------------------------------------------------
# Project Dependencies (if requirements.txt exists)
# -----------------------------------------------------------------------------
# 이 부분은 빌드 시 프로젝트 의존성을 설치합니다.
# 캐시 레이어를 활용하기 위해 requirements.txt만 먼저 복사합니다.

COPY requirements*.txt ./
RUN if [ -f requirements.txt ]; then \
        pip install -r requirements.txt; \
    fi && \
    if [ -f requirements-dev.txt ]; then \
        pip install -r requirements-dev.txt; \
    fi

# -----------------------------------------------------------------------------
# Source Code (마지막에 복사 - 캐시 활용)
# -----------------------------------------------------------------------------
# 실제 실행 시에는 볼륨 마운트를 사용하므로 이 단계는 선택적입니다.
# COPY . .

# -----------------------------------------------------------------------------
# Default Command
# -----------------------------------------------------------------------------
CMD ["python", "--version"]