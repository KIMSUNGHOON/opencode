{
  "$schema": "https://opencode.ai/config.json",

  // =============================================================================
  // Dual Model Provider Configuration
  // =============================================================================
  // H100 NVL x4 단일 서버 구성:
  //   - H100 (0, 1) port 8000: Qwen3-Next-Thinking (SGLang) -> 추론 집약 에이전트
  //   - H100 (2, 3) port 8001: Devstral-2-123B (vLLM)       -> 코드/유틸리티 에이전트
  //
  // Model Assignment:
  //   Thinking (qwen/Qwen3-Next-80B-A3B-Thinking-FP8):
  //     - Orchestrator (code-qa), code-reviewer, quality-checker, summary-reporter
  //   Coder (devstral/Devstral-2-123B):
  //     - env-setup, git-input, workspace-analyzer, pre-checker, code-fixer,
  //       build-tester, function-tester, git-committer, git-pusher, file-input
  //
  // vLLM Startup Commands:
  //   Thinking (SGLang):
  //     CUDA_VISIBLE_DEVICES=0,1 python -m sglang.launch_server \
  //       --model Qwen/Qwen3-Next-80B-A3B-Thinking-FP8 --port 8000 --tp-size 2
  //
  //   Coder (vLLM):
  //     CUDA_VISIBLE_DEVICES=2,3 vllm serve mistralai/Devstral-2-123B-Instruct-2512 \
  //       --port 8001 --served-model-name Devstral-2-123B \
  //       --tensor-parallel-size 2 --enable-auto-tool-choice --tool-call-parser mistral
  // =============================================================================

  "provider": {
    // -------------------------------------------------------------------------
    // Provider 1: Thinking Model (SGLang, H100 0-1, port 8000)
    // -------------------------------------------------------------------------
    "qwen": {
      "name": "Qwen3-Next-Thinking (Reasoning)",
      "npm": "@ai-sdk/openai-compatible",
      "api": "http://localhost:8000/v1",
      "env": [],
      "options": {
        "apiKey": "dummy",
        "baseURL": "http://localhost:8000/v1"
      },
      "models": {
        "Qwen3-Next-80B-A3B-Thinking-FP8": {
          "name": "Qwen3-Next-80B-A3B-Thinking-FP8",
          "id": "Qwen3-Next-80B-A3B-Thinking-FP8",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "attachment": false,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 16384
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    },

    // -------------------------------------------------------------------------
    // Provider 2: Coder Model (vLLM, H100 2-3, port 8001)
    // Devstral-2-123B-Instruct-2512 (Mistral AI)
    // Tool parser: mistral
    // -------------------------------------------------------------------------
    "devstral": {
      "name": "Devstral-2-123B (Code)",
      "npm": "@ai-sdk/openai-compatible",
      "api": "http://localhost:8001/v1",
      "env": [],
      "options": {
        "apiKey": "dummy",
        "baseURL": "http://localhost:8001/v1"
      },
      "models": {
        "Devstral-2-123B": {
          "name": "Devstral-2-123B-Instruct",
          "id": "Devstral-2-123B",
          "tool_call": true,
          "temperature": true,
          "reasoning": false,
          "attachment": false,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 16384
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    }
  }
}
